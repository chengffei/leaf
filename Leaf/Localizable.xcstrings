    "Saves font, size, weight, spacing, margins, text width, columns and alignment. Theme is kept separate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert Schrift, Größe, Strichstärke, Abstände, Ränder, Textbreite, Spalten und Ausrichtung. Das Thema bleibt getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda fuente, tamaño, grosor, espaciado, márgenes, ancho del texto, columnas y alineación. El tema es aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre la police, la taille, la graisse, les espacements, les marges, la largeur du texte, les colonnes et l’alignement. Le thème est à part."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォント、サイズ、太さ、間隔、余白、本文の幅、段組み、揃えを保存します。テーマは含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴, 크기, 굵기, 간격, 여백, 본문 너비, 단, 정렬을 저장합니다. 테마는 별도입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存字体、字号、字重、间距、页边距、版心、分栏和对齐；主题另算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存字體、字級、字重、間距、頁邊距、版心、分欄和對齊；主題另計。"
          }
        }
      }
    },
