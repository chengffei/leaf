    "Delete All Notes and Highlights?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部标注与高亮？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除全部標註與標示？"
          }
        },
        "ja": {
          "stringUnit": {
