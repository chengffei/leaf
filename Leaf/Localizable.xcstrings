    "This removes every highlight, note and bookmark in every book. It can’t be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除所有书里的全部高亮、笔记和书签，不能撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除所有書裡的全部標示、筆記和書籤，無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての本のハイライト、メモ、ブックマークを削除します。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 책의 하이라이트, 메모, 책갈피를 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les surlignages, notes et signets de tous les livres. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Markierungen, Notizen und Lesezeichen in allen Büchern gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los resaltados, notas y marcadores de todos los libros. No se puede deshacer."
          }
        }
      }
    },
    "Notes and highlights in %lld books. Export them from the Notes menu first.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Notes and highlights in %lld book. Export them from the Notes menu first."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
