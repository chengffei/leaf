                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaf 记着 %lld 本书的阅读位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaf 記著 %lld 本書的閱讀位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 冊の本の読書位置を記憶しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책 %lld권의 읽던 위치를 기억하고 있습니다."
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Leaf se souvient de votre position dans %lld livre."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Leaf se souvient de votre position dans %lld livres."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Leaf merkt sich die Leseposition in %lld Buch."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Leaf merkt sich die Leseposition in %lld Büchern."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
