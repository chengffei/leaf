    "Select text to highlight it. Press ⌘D to bookmark the page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中文字即可高亮。按 ⌘D 给当前页加书签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取文字即可標示。按 ⌘D 為目前頁面加入書籤。"
          }
