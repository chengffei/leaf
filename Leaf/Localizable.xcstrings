                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Leaf recuerda dónde te quedaste en %lld libros."
                }
              }
            }
          }
        }
      }
    },
    "Leaf will forget where you stopped in every book and how fast you read. Your books stay as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaf 会忘掉每本书读到哪，以及你的阅读速度。书本身不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaf 會忘掉每本書讀到哪裡，以及你的閱讀速度。書本身不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての本の読書位置と読む速さを忘れます。本そのものは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 책의 읽던 위치와 읽는 속도를 잊습니다. 책 파일은 그대로입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaf oubliera votre position dans chaque livre et votre vitesse de lecture. Vos livres ne sont pas modifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaf vergisst die Leseposition in allen Büchern und dein Lesetempo. Deine Bücher bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaf olvidará dónde te quedaste en cada libro y tu ritmo de lectura. Tus libros no se modifican."
          }
        }
      }
    },
